# Hugging Face API Token
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# OpenAI API Key (for GPT-3.5-turbo and other OpenAI models)
# Get your key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ChatGLM API Key (if using ChatGLM API)
CHATGLM_API_KEY=your_chatglm_api_key_here

# Neuronpedia API Key (for EasySteer demo)
# Get your key from Neuronpedia
NP_API_KEY=your_neuronpedia_api_key_here

# Optional: Proxy settings (uncomment if needed)
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
